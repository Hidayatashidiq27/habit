# ==========================================================================
# Streakin — contoh environment. Salin ke .env.local lalu isi nilai asli.
#   cp .env.example .env.local
# ==========================================================================

# --- Supabase (WAJIB) -----------------------------------------------------
# Dapatkan dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Service role key — HANYA dipakai di server (cron/job), JANGAN pakai NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# --- URL aplikasi (untuk redirect OAuth & share link) ---------------------
# Saat lokal: http://localhost:3000 ; saat production: https://domainanda.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Web Push (opsional, untuk push notification reminder) ----------------
# Generate dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@domainanda.com

# --- Payment (opsional, fase premium — Midtrans Snap) ---------------------
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
